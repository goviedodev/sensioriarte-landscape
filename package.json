{
	"name": "sensoriarte",
	"description": "Landing de Sensoriarte, tienda de material sensorial en Limache. React Router 7 sobre Cloudflare Workers.",
	"dependencies": {
		"isbot": "5.1.32",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-router": "7.9.6"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@react-router/dev": "7.9.6",
		"@tailwindcss/vite": "4.1.17",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"tailwindcss": "4.1.17",
		"typescript": "5.9.3",
		"vite": "^7.0.0",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "^3.2.7",
		"wrangler": "4.127.0"
	},
	"private": true,
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types && react-router typegen",
		"check": "tsc && react-router build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "react-router dev",
		"preview": "npm run build && vite preview",
		"typecheck": "npm run typegen && tsc -b",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typegen": "wrangler types && react-router typegen"
	},
	"type": "module"
}
